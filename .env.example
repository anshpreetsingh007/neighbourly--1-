# Postgres connection string used by Prisma (server-side only)
DATABASE_URL=

# Supabase project credentials (client-side, used for auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary credentials (server-side only, used to sign image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: free CARTO basemap key for the dark map style, from
# https://carto.com/basemaps/apikey - without it the map falls back to
# OpenStreetMap's light tiles. 5M tile requests/month on the free tier.
VITE_CARTO_API_KEY=

# Production hardening (both optional, both no-ops in development)
#
# Comma-separated list of origins allowed to call the API and open a socket.
# Leave blank to allow any origin. Set this to your deployed URL in production,
# e.g. https://neighbourly-1.vercel.app
CORS_ORIGIN=

# The Content-Security-Policy ships in report-only mode so a wrong rule cannot
# white-screen the site. Check a real deploy's console for violation reports,
# then set this to "true" to actually enforce it.
CSP_ENFORCE=

# Optional: disables Vite HMR when set to "true"
DISABLE_HMR=
